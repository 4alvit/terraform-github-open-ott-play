{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "terraform",
    "pip_requirements",
    "pip-compile"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "security/provider/**",
    "tools/browser-compatibility/**"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.(txt|pip)$/"
    ],
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      "security/provider/**",
      "tools/browser-compatibility/**",
      "requirements-security-tests.txt"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements-security-tests\\.txt$/"
    ]
  }
}
